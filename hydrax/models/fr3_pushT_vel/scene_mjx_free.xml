<mujoco model="fr3 scene">

  <!-- NUmerical Stuff -->
  <option impratio="0.7"
          solver="Newton"
          jacobian="dense"
          cone="pyramidal"
          timestep="0.02" 
          iterations="6"
          ls_iterations="8"
          ls_tolerance="0.00001"
          noslip_iterations="0">
  <flag eulerdamp="enable" 
        warmstart="disable"/>
  </option>
  <!-- <custom> -->
    <!-- <numeric data="32" name="max_contact_points"/> -->
    <!-- <numeric name="maxhullverts"   data="32"/> -->
    <!-- <numeric data="128" name="max_geom_pairs"/> -->
  <!-- </custom> -->

  <size nconmax="64"/>
  <size njmax="1200"/>

  <default>
    <geom contype="7" conaffinity="7"/>
  </default>
  <!-- Default settings for friction -->
  <default>
    <default class="tblock">
      <!-- friction = [slide spin roll]; keep your values -->
      <geom friction="0.6 0.001 0.001" 
            solref="0.04 1.0" 
            solimp="0.9 0.95 0.001 0.5 2"
            condim="3"
            contype="2" 
            conaffinity="5"/>  
    </default>
    <default class="goal">
      <geom conaffinity="0" 
            contype="0" 
            rgba="0 1 0 0.2"/>
    </default>
  </default>

  <!-- Push T setup -->
  <worldbody>
    <camera name='top_view' pos="-0.276 -0.512 0.817" xyaxes="0.864 -0.503 0.000 0.404 0.694 0.596"/>
    <camera name="comparison" pos="1.107 -0.076 0.436" xyaxes="0.178 0.984 -0.000 -0.466 0.084 0.881"/>

    <body name="goal" mocap="true" pos="0.45 0.0 0.009" quat="1 0 0 -1">
      <geom class="goal" name="goal_bottom" type="box" size=".025 0.05 0.025"/>
      <geom class="goal" name="goal_top" type="box" size=".06 0.025 0.025" pos="0.0 0.075 0.0"/>
    </body>
    <!-- ghost sphere -->
    <body name="ghost_sphere" mocap="true" pos="0.5 0.0 0.035" quat="0 0.7071068 0.7071068 0">
      <geom type="sphere" size="0.32" contype="0" conaffinity="0" rgba="1 0 0 0.05"/>
    </body>
    <!-- Ghost block to stabilize simulation -->
    <body name="ghost_block" mocap="true" pos="0.5 0.0 0.036" quat="1 0 0 -1">
      <geom type="box" size=".025 0.05 0.025" contype="0" conaffinity="0" rgba="1 0 0 0.1"/> 

      <!-- <body name="z_adapter" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.01" diaginertia="0.001 0.001 0.001"/>

          <joint name="slip_z" type="slide" axis="0 0 1" damping="0.0"/>
      </body> -->
    </body>

    <body name="block" pos="0.5 0.0 0.036" quat="1 0 0 -1">
      <joint name="T" type="free"/>
      <geom class="tblock" name="bottom" type="box" size=".025 0.05 0.025" pos="0.0 0.0 0.0" mass="0.0655"/>
        <site name="T_1" pos="0 0 0" size="0.015" rgba="0 0 0 1"/>
        <site name="T_2" pos="0 0.08 0" size="0.015" rgba="0 0 0 1"/>
      <geom class="tblock" name="top" type="box" size=".06 0.025 0.025" pos="0.0 0.075 0.0"  mass="0.07855"/>

    </body>
  </worldbody>


  <!-- Robot model -->
  <include file="fr3_vel_mjx.xml"/>

  <worldbody>

    <body name="sphere_carrier" pos="0.45 0 0.035" quat="0 0.7071068 0.7071068 0"> 
      <joint name="carrier_x" type="slide" axis="1 0 0" damping="0" frictionloss="0" armature="0" stiffness="0"/>             <!-- x -->
      <joint name="carrier_y" type="slide" axis="0 1 0" damping="0" frictionloss="0" armature="0" stiffness="0"/>             <!-- y -->
      <joint type="hinge" axis="0 0 1" damping="0" frictionloss="0" armature="0" stiffness="0"/>      
      <geom name="ee_sphere" type="sphere" size="0.015"
            friction="0 0.0 0.0"
            contype="0" conaffinity="0"/>
      <site name="sphere_site" pos="0 0 0"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="ee_frame" body2="sphere_carrier"/>
  </contact>

  <equality>
    <!-- (Linear) equality constraint for end effector -->
    <connect site1="ee_site" site2="sphere_site"
             solref="0.04 1.0" 
             solimp="0.9 0.99 0.001 0.1 20.0"/>
    <!-- Full 6 DoF equality MoCAP vs free object -->
    <!-- <weld name="sensor_coupling" body1="block" body2="ghost_block" solref="0.055 1" solimp="0.9 0.99 0.001"/> -->
  </equality>

  <sensor>
    <framepos name="position" objtype="body" objname="block" reftype="body" refname="goal"/>
    <framequat name="orientation" objtype="body" objname="block" reftype="body" refname="goal"/>
    <framepos name="safety" objtype="body" objname="ee_frame" reftype="body" refname="goal"/>
  
    <framepos name="position_world" objtype="body" objname="block" reftype="body" refname="world"/>
  </sensor>

  <!-- Defines the spatial region to compute model statistics like mass, center of mass, etc. -->
  <statistic center="0.4 0 0.0" extent="1.0"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          solref="0.04 1"
          friction="0.6 0.005 0.001" 
          condim="3"
          solimp="0.7 0.99 0.001"
          contype="4" conaffinity="3"/>  
  </worldbody>
</mujoco>
